# Never commit actual credentials. Import these through your hosting secret manager.
PUBLIC_ORIGIN=https://YOUR-VERIFIED-ADMIN-HOST
OUTREACH_DB=/data/outreach.sqlite
EMAIL_PROVIDER=gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ALLOWED_EMAIL=
# Gmail needs Google authorization, not domain DNS or a Mailgun account.
# Set EMAIL_PROVIDER=mailgun only to restore the optional domain adapter below.
MAILGUN_API_KEY=
MAILGUN_SIGNING_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
MAIL_FROM=
MAIL_REPLY_TO=
UNSUBSCRIBE_SECRET=
AI_SERVICE_TOKEN=
EMAIL_ENABLED=false
DOMAIN_VERIFIED=false
PROVIDER_USE_APPROVED=false
# LOCAL_DEV is only for a loopback development server; omit in production.
